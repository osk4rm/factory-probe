{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=swarmapp;Username=postgres;Password=postgres"
  },
  "OpenTelemetry": {
    "Endpoint": "http://localhost:4317"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Email": {
    "Provider": "file",
    "FromAddress": "no-reply@localhost",
    "FromName": "Swarm App",
    "PublicBaseUrl": "http://localhost:5173",
    "File": {
      "Directory": "data/emails"
    }
  },
  "AllowedHosts": "*"
}
